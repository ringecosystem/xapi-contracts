    "cookie": "0.7.0",
    "elliptic": "6.6.1",
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.0",
    "**/then-request/form-data": "2.5.6",
    "form-data": "4.0.6",
    "handlebars": "4.7.10",
